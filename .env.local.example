# Bind locally until a TLS-authenticated reverse proxy is configured.
DOLA_HOST=127.0.0.1
DOLA_PORT=8000

# The Windows launcher sets this to %LOCALAPPDATA%\DolaGateway.
# Relative mutable paths below are resolved inside that directory.
DOLA_STATE_DIR=

# Set strong, different values in .env.local.
DOLA_API_KEYS=replace-with-a-long-random-client-key
DOLA_ADMIN_KEY=replace-with-a-long-random-admin-key

# Optional override. Leave empty to use Patchright's bundled Chromium.
DOLA_BROWSER_EXECUTABLE=

# Leave empty unless a permitted proxy is required.
DOLA_PROXY=
DOLA_HEADLESS=1
# Set to 0 when Dola requests a challenge; solve it manually in Chromium.
DOLA_IMAGE_HEADLESS=1
DOLA_MAX_CONCURRENCY=1
DOLA_LOGIN_TIMEOUT=600
DOLA_VIDEO_VERIFICATION_TIMEOUT=180
DOLA_VIDEO_TIMEOUT=900
DOLA_IMAGE_TIMEOUT=180
DOLA_IMAGE_SETTLE_SECONDS=5
DOLA_IMAGE_MAX_BYTES=26214400

# Credential-free local inventory. Browser sessions remain under accounts/<name>/.
DOLA_ACCOUNTS_CONFIG=accounts.local.json
DOLA_ACCOUNTS_DIR=accounts
DOLA_DB_PATH=tasks.db
DOLA_POOL_DB_PATH=pool_usage.db
DOLA_DOWNLOAD_DIR=downloads

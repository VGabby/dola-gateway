#!/bin/bash
set -u

resources="$(cd "$(dirname "$0")/../Resources" && pwd)"
launcher="$resources/launcher"
state_dir="$HOME/Library/Application Support/DolaGateway"

if [[ ! -x "$HOME/Library/Caches/DolaGateway/venv/bin/python" || ! -f "$state_dir/.env.local" ]]; then
    /usr/bin/open -a Terminal "$launcher/setup.command"
    exit 0
fi

exec "$launcher/run.sh"
